---
/**
 * Inicio: replica la composición de docs/Ejemplo.png.
 * Izquierda: retrato flotando dentro de anillos concéntricos.
 * Derecha: estado, saludo, rol, presentación, métricas y botones.
 */
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { attr, t, type I18nKey } from '../i18n';
import { site } from '../data/site';
import { projects } from '../data/projects';
import portrait from '../assets/foto-perfil.png';

/** `count`: número que se anima de 0 a su valor al cargar (scripts/motion.ts). */
const metrics: { value: string; count?: number; suffix?: string; label: I18nKey }[] = [
  { value: `${site.internshipHours}h`, count: site.internshipHours, suffix: 'h', label: 'hero.metric.hours' },
  { value: String(projects.length), count: projects.length, label: 'hero.metric.projects' },
  { value: 'C1', label: 'hero.metric.english' },
];
---

<section id="home" class="hero" aria-labelledby="home-title" data-section>
  <div class="container hero__grid">
    <div class="hero__visual enter enter--zoom" style="--d: 0">
      <div class="portrait">
        <span class="portrait__orbit" aria-hidden="true"><span class="portrait__satellite"></span></span>
        <span class="portrait__ring portrait__ring--outer" aria-hidden="true"></span>
        <span class="portrait__ring portrait__ring--inner" aria-hidden="true"></span>
        <div class="portrait__float">
          <div class="portrait__disc">
            <Image
              src={portrait}
              alt={t('hero.photoAlt')}
              data-i18n-attr={attr({ alt: 'hero.photoAlt' })}
              widths={[320, 480, 720, 960]}
              sizes="(max-width: 860px) 70vw, 420px"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>

    <div class="hero__content">
      <p class="status enter" style="--d: 1">
        <span class="status__dot" aria-hidden="true"></span>
        <span data-i18n="hero.status">{t('hero.status')}</span>
      </p>

      <h1 id="home-title" class="hero__title enter" style="--d: 2">
        <span data-i18n="hero.greeting">{t('hero.greeting')}</span>{' '}
        <span class="hero__name">{site.name}</span>
      </h1>

      <p class="hero__role enter" style="--d: 3">
        <span class="hero__bracket" aria-hidden="true">&lt;</span>{' '}
        <span data-i18n="hero.role">{t('hero.role')}</span>{' '}
        <span class="hero__bracket" aria-hidden="true">&gt;</span><span class="hero__caret" aria-hidden="true"></span>
      </p>

      <p class="hero__intro enter" style="--d: 4" data-i18n="hero.intro">{t('hero.intro')}</p>

      <dl class="metrics enter" style="--d: 5">
        {
          metrics.map((metric) => (
            <div class="metric">
              <dt class="metric__label" data-i18n={metric.label}>
                {t(metric.label)}
              </dt>
              <dd class="metric__value">
                {metric.count !== undefined ? (
                  <>
                    <span data-count-to={metric.count}>{metric.count}</span>
                    {metric.suffix}
                  </>
                ) : (
                  metric.value
                )}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="hero__actions enter" style="--d: 6">
        <Button href={site.cv} label="hero.cv" icon="download" download />
        <Button href="#contact" label="hero.contact" icon="mail" variant="outline" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100dvh;
    display: grid;
    align-items: center;
    padding-block: var(--space-7) calc(var(--space-5) + var(--dock-clearance));
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .hero__content,
  .hero__visual {
    min-width: 0;
  }

  /* ───────── Retrato ───────── */
  .hero__visual {
    display: grid;
    place-items: center;
  }

  .portrait {
    position: relative;
    width: min(100%, 460px);
    aspect-ratio: 1;
  }

  .portrait__ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid var(--accent-border);
    animation: ring-pulse 7s ease-in-out infinite;
    will-change: transform;
  }

  .portrait__ring--outer {
    inset: 0;
    opacity: 0.55;
  }

  .portrait__ring--inner {
    inset: 6%;
    border-width: 2px;
    animation-delay: -3.5s;
  }

  /* Satélite que orbita sobre el anillo exterior */
  .portrait__orbit {
    position: absolute;
    inset: 0;
    z-index: 2;
    animation: orbit 16s linear infinite;
    pointer-events: none;
  }

  .portrait__satellite {
    position: absolute;
    top: 0;
    left: 50%;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    translate: -50% -50%;
    background: var(--accent);
    box-shadow:
      0 0 0 4px var(--ring),
      0 0 18px 2px hsl(var(--accent-h) 90% 55% / 0.7);
  }

  @keyframes orbit {
    to {
      rotate: 1turn;
    }
  }

  /*
   * El grupo que flota se rasteriza una vez y se mueve como una sola capa
   * (will-change): sin esto, Chrome vuelve a recortar el círculo en cada fotograma
   * en posiciones fraccionarias y aparecen rayas finas en el borde y entre teselas.
   */
  .portrait__float {
    position: absolute;
    inset: 10%;
    animation: float 6s ease-in-out infinite;
    will-change: transform;
    backface-visibility: hidden;
  }

  /* Halo: capa propia detrás del disco, para no compartir el recorte con la foto */
  .portrait__float::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    box-shadow: 0 0 80px -10px hsl(var(--accent-h) 90% 45% / 0.45);
  }

  /* Aro fino por encima de la foto, también fuera del recorte */
  .portrait__float::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--accent-border);
    pointer-events: none;
  }

  /* El círculo se recorta con clip-path (sin overflow + border-radius) */
  .portrait__disc {
    position: relative;
    width: 100%;
    height: 100%;
    clip-path: circle(50% at 50% 50%);
    background: radial-gradient(circle at 50% 40%, var(--disc-from), var(--disc-to) 70%);
  }

  .portrait__disc :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  @keyframes float {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(0, -16px, 0);
    }
  }

  @keyframes ring-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.025);
    }
  }

  /* ───────── Texto ───────── */
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.45em 1.1em;
    margin-bottom: var(--space-5);
    font-size: var(--text-sm);
    font-weight: 500;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
  }

  .status__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 0 var(--success);
    animation: status-ping 2.4s ease-out infinite;
  }

  @keyframes status-ping {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--success) 60%, transparent);
    }
    100% {
      box-shadow: 0 0 0 9px transparent;
    }
  }

  .hero__title {
    font-size: var(--text-hero);
    font-weight: 800;
  }

  .hero__name {
    position: relative;
    display: inline-block;
    color: var(--accent-text);
  }

  /* Subrayado que se dibuja una vez, cuando termina la entrada del título */
  .hero__name::after {
    content: '';
    position: absolute;
    left: 0.04em;
    right: 0.04em;
    bottom: 0.02em;
    height: 0.09em;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--accent), var(--accent-text));
    transform-origin: left;
    animation: draw-x 900ms var(--ease) 1000ms both;
  }

  @keyframes draw-x {
    from {
      scale: 0 1;
    }
  }

  .hero__caret {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.35em;
    vertical-align: text-bottom;
    background: var(--accent-text);
    animation: caret-blink 1.1s steps(1) infinite;
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  .hero__role {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: clamp(0.95rem, 0.8rem + 0.8vw, 1.3rem);
    color: var(--accent-text);
  }

  .hero__bracket {
    color: var(--text-muted);
  }

  .hero__intro {
    margin-top: var(--space-5);
    max-width: 54ch;
    font-size: var(--text-lg);
    color: var(--text-muted);
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-7);
    margin: var(--space-6) 0;
  }

  .metric {
    display: flex;
    flex-direction: column-reverse;
  }

  .metric__value {
    margin: 0;
    font-variant-numeric: tabular-nums;
    font-size: var(--text-xl);
    font-weight: 800;
    line-height: 1.2;
  }

  .metric__label {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (max-width: 860px) {
    .hero {
      padding-top: var(--space-6);
    }

    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      text-align: center;
    }

    .portrait {
      width: min(70vw, 320px);
    }

    .hero__intro {
      margin-inline: auto;
    }

    .metrics,
    .hero__actions {
      justify-content: center;
    }
  }
  /* En horizontal bajo, el contenido crece y conserva el hueco del dock. */
  @media (max-height: 520px) {
    .hero {
      padding-top: var(--space-5);
    }

    .portrait {
      width: min(100%, 40vh);
    }

    .hero__grid {
      gap: var(--space-5);
    }
  }
</style>
