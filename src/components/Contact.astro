---
/**
 * Contacto: formulario (Nombre, Email, Mensaje) que se envía por Web3Forms.
 * La clave se configura en `.env` (PUBLIC_WEB3FORMS_KEY, ver .env.example).
 * Lógica en scripts/contact-form.ts.
 */
import Section from './Section.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { t } from '../i18n';
import { site, WEB3FORMS_ENDPOINT, WEB3FORMS_KEY } from '../data/site';
---

<Section id="contact" eyebrow="contact.eyebrow" title="contact.title">
  <div class="contact">
    <div class="contact__intro reveal">
      <p class="contact__lead" data-i18n="contact.lead">{t('contact.lead')}</p>
      <p class="contact__direct">
        <span data-i18n="contact.direct">{t('contact.direct')}</span>
        <a class="contact__mail" href={`mailto:${site.email}`}>
          <Icon name="mail" size={18} />
          <span>{site.email}</span>
        </a>
      </p>
    </div>

    <form
      class="form card reveal"
      novalidate
      data-contact-form
      data-access-key={WEB3FORMS_KEY}
      data-endpoint={WEB3FORMS_ENDPOINT}
      data-status="idle"
    >
      <div class="form__field">
        <label class="form__label" for="contact-name" data-i18n="contact.name">
          {t('contact.name')}
        </label>
        <input
          class="form__input"
          id="contact-name"
          name="name"
          type="text"
          autocomplete="name"
          required
          aria-describedby="contact-name-error"
        />
        <p class="form__error" id="contact-name-error" data-error-for="name" aria-live="polite"></p>
      </div>

      <div class="form__field">
        <label class="form__label" for="contact-email" data-i18n="contact.email">
          {t('contact.email')}
        </label>
        <input
          class="form__input"
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          required
          aria-describedby="contact-email-error"
        />
        <p class="form__error" id="contact-email-error" data-error-for="email" aria-live="polite">
        </p>
      </div>

      <div class="form__field">
        <label class="form__label" for="contact-message" data-i18n="contact.message">
          {t('contact.message')}
        </label>
        <textarea
          class="form__input form__input--area"
          id="contact-message"
          name="message"
          rows="5"
          required
          aria-describedby="contact-message-error"></textarea>
        <p
          class="form__error"
          id="contact-message-error"
          data-error-for="message"
          aria-live="polite"
        >
        </p>
      </div>

      <!-- Honeypot anti-spam: invisible para personas, los bots lo marcan. -->
      <input class="form__trap" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="form__footer">
        <Button type="submit" label="contact.send" icon="send" />
        <p class="form__status" role="status" data-form-status data-state="idle">
          <span class="form__status-icon form__status-icon--ok"><Icon name="check" size={18} /></span>
          <span class="form__status-icon form__status-icon--bad"><Icon name="alert" size={18} /></span>
          <span data-form-status-text></span>
        </p>
      </div>
    </form>
  </div>
</Section>

<script>
  import '../scripts/contact-form';
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .contact__intro,
  .contact__mail,
  .contact__mail span,
  .form,
  .form__field,
  .form__input,
  .form__status {
    min-width: 0;
    max-width: 100%;
  }

  .contact__lead {
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.35;
  }

  .contact__direct {
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    color: var(--text-muted);
  }

  .contact__mail {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-weight: 600;
    color: var(--accent-text);
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size var(--dur) var(--ease);
  }

  .contact__mail:hover,
  .contact__mail:focus-visible {
    background-size: 100% 2px;
  }

  /* ───────── Formulario ───────── */
  .form {
    display: grid;
    gap: var(--space-5);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .form__field {
    display: grid;
    gap: var(--space-2);
  }

  .form__label {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .form__input {
    width: 100%;
    padding: 0.8em 1em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    transition:
      border-color var(--dur-fast) ease,
      box-shadow var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }

  .form__input--area {
    resize: vertical;
    min-height: 8rem;
  }

  .form__input:hover {
    border-color: var(--accent-border);
  }

  .form__input:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 3px;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--ring);
    background: var(--surface-hover);
  }

  .form__input[aria-invalid='true'] {
    border-color: var(--danger);
  }

  .form__input[aria-invalid='false'] {
    border-color: var(--success);
  }

  .form__error {
    min-height: 1.3em;
    font-size: var(--text-sm);
    line-height: 1.3;
    color: var(--danger);
  }

  .form__trap {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .form__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .form__status {
    display: flex;
    flex: 1 1 14rem;
    align-items: center;
    gap: 0.5em;
    font-size: var(--text-sm);
    font-weight: 500;
    animation: status-in 400ms var(--ease);
  }

  .form__status-icon {
    display: none;
    flex-shrink: 0;
  }

  /* La región permanece accesible, sin ocupar espacio antes del primer envío. */
  .form__status[data-state='idle'] {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .form__status[data-state='success'] {
    color: var(--success);
  }

  .form__status[data-state='error'],
  .form__status[data-state='warning'] {
    color: var(--danger);
  }

  .form__status[data-state='success'] .form__status-icon--ok,
  .form__status[data-state='error'] .form__status-icon--bad,
  .form__status[data-state='warning'] .form__status-icon--bad {
    display: inline-flex;
  }

  @keyframes status-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @media (max-width: 820px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
